<Page x:Class="WPF.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF.Pages"
      xmlns:external="clr-namespace:Core.Movement;assembly=Core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage">
    <StackPanel>
        <DockPanel VerticalAlignment="Center" Margin="10">
            <TextBlock Text = "Board Rows:" Margin = "10" FontSize="16"/>
            <TextBlock Text="{Binding ElementName=BoardRows, Path=Value, UpdateSourceTrigger=PropertyChanged}" 
                       TextAlignment="Right" Margin="12" Height="25" Width="25" FontSize="16"/>
            <Slider Name="BoardRows" Width="300" HorizontalAlignment="Left"
                IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                Minimum="18" Maximum="26" Focusable="False"
                Ticks="18, 20, 22, 24, 26" Margin = "10"
                Thumb.DragStarted="SliderDragStarted"
                Thumb.DragCompleted="RowSliderDragCompleted"/>
        </DockPanel>
        <DockPanel VerticalAlignment="Center" Margin="5">
            <TextBlock Text = "Board Columns:" Margin = "10" FontSize="16"/>
            <TextBlock Text="{Binding ElementName=BoardColumns, Path=Value, UpdateSourceTrigger=PropertyChanged}" 
                       TextAlignment="Right" Height="25" Width="25" FontSize="16"/>
            <Slider Name="BoardColumns" Width="300" HorizontalAlignment="Left"
                IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                Minimum="7" Maximum="15" Focusable="False"
                Ticks="7, 9, 11, 13, 15" Margin = "10"
                Thumb.DragStarted="SliderDragStarted"
                Thumb.DragCompleted="ColumnSliderDragCompleted"/>
        </DockPanel>
        <Separator Margin="10"/>
        <ComboBox Name ="ArchetypeCombo"
                  ItemsSource="{Binding Archetypes}"
                  SelectionChanged="ArchetypeSelectionChanged"
                  DisplayMemberPath="Name"
                  SelectedIndex="0" 
                  Width="200" 
                  Height="30"
                  VerticalContentAlignment="Center"/>
        <Grid>
            <UniformGrid
            x:Name="DemoBoardGrid"
            Width="auto"
            Height="auto"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="10"/>
        </Grid>
        <DockPanel HorizontalAlignment="Center" Margin="10">
            <DockPanel.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            </DockPanel.Resources>
            <UniformGrid x:Name ="FirstGrid" Columns="3" Rows="3" Width="150" Height="150" Margin="20">
                <Button Content="↖" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.ForwardLeft}"/>
                <Button Content="↑" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.Forward}"/>
                <Button Content="↗" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.ForwardRight}"/>
                <Button Content="←" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.Left}"/>
                <Rectangle
                    Width="50"
                    Height="50"
                    Fill="White"/>
                <Button Content="→" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.Right}"/>
                <Button Content="↙" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.BackLeft}"/>
                <Button Content="↓" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.Back}"/>
                <Button Content="↘" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.BackRight}"/>
            </UniformGrid>

            <UniformGrid x:Name ="SecondGrid" Columns="3" Rows="3" Width="150" Height="150" Margin="20" 
                         Visibility="{Binding SelectedUnitType.SecondMoveSettings.IsActive, Mode=OneWay, 
                        Converter={StaticResource BoolToVisConverter}}">
                <Button Content="↖" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.ForwardLeft}"/>
                <Button Content="↑" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.Forward}"/>
                <Button Content="↗" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.ForwardRight}"/>
                <Button Content="←" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.Left}"/>
                <Rectangle
                        Width="50"
                        Height="50"
                        Fill="White"/>
                <Button Content="→" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.Right}"/>
                <Button Content="↙" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.BackLeft}"/>
                <Button Content="↓" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.Back}"/>
                <Button Content="↘" FontSize="30" FontWeight="Bold" Click="OpenMovementRangeWindow" 
                        Tag="{x:Static external:DirectionName.BackRight}"/>
            </UniformGrid>
            <StackPanel>
                <CheckBox x:Name="IsActiveCB" Grid.Row="1" Margin="5,0,0,0" Content="Enable two-step movement"
                    IsChecked="{Binding SelectedUnitType.SecondMoveSettings.IsActive, Mode=OneWay}" 
                          Click="Setting_Changed"/>
                <StackPanel x:Name ="ConditionCB" Visibility="{Binding SelectedUnitType.SecondMoveSettings.IsActive, Mode=OneWay, 
                        Converter={StaticResource BoolToVisConverter}}">
                    <CheckBox x:Name="IsConditionalCB" Grid.Row="1" Margin="5,0,0,0" Content="Second step has conditions"
                        IsChecked="{Binding SelectedUnitType.SecondMoveSettings.IsConditional, Mode=OneWay}" 
                              Click="Setting_Changed"/>
                    <StackPanel x:Name="ConditionsCB" Visibility="{Binding SelectedUnitType.SecondMoveSettings.IsConditional, Mode=OneWay, 
                         Converter={StaticResource BoolToVisConverter}}">
                        <CheckBox x:Name="InverseAxesCB" Grid.Row="1" Margin="5,0,0,0" Content="Condition: Second step must be on inverted axis"
                            IsChecked="{Binding SelectedUnitType.SecondMoveSettings.InverseAxes, Mode=OneWay}" 
                                  Click="Setting_Changed"/>
                        <DockPanel HorizontalAlignment="Center" Margin="5">
                            <TextBlock Text = "Combined minimum total steps" Margin = "10" FontSize="12"/>
                            <TextBox Name ="MinCombinedDistanceBox" Text="{Binding SelectedUnitType.SecondMoveSettings.MinCombinedDistance}"
                                     LostFocus="Setting_Changed" Height="25" Width="25" FontSize="16"/>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Center" Margin="5">
                            <TextBlock Text = "Combined maximum total steps" Margin = "10" FontSize="12"/>
                            <TextBox Name ="MaxCombinedDistanceBox" Text="{Binding SelectedUnitType.SecondMoveSettings.MaxCombinedDistance}" 
                                     LostFocus="Setting_Changed" Height="25" Width="25" FontSize="16"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
        <Button Content="Save and exit"
            Click="SaveExitClick" Height="50" Width="200"/>
    </StackPanel>
</Page>
