<Page x:Class="WPF.Pages.MoveRangesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="250" d:DesignWidth="350"
      Title="MoveRangesPage">

    <StackPanel>
        <DockPanel HorizontalAlignment="Center" Margin="5">
            <TextBlock Name ="MovementStep" HorizontalAlignment="Center" FontSize="18"/>
            <TextBlock HorizontalAlignment="Center" Text = "Movement range for " FontSize="18"/>
            <TextBlock Name ="TextUnitName" HorizontalAlignment="Center" FontSize="18"/>
        </DockPanel>
        <Separator></Separator>
        <DockPanel HorizontalAlignment="Center" Margin="5">
            <TextBlock Text = "Minimum Steps:" Margin = "10" FontSize="16"/>
            <TextBox Name ="MinDistanceBox" Text="{Binding ElementName=NewMovementRule.MinDistance, Path=Value, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Height="25" Width="25" FontSize="16"/>
        </DockPanel>
        <DockPanel HorizontalAlignment="Center" Margin="5">
            <TextBlock Text = "Maximum Steps:" Margin = "10" FontSize="16"/>
            <TextBox Name ="MaxDistanceBox" Text="{Binding ElementName=NewMovementRule.MaxDistance, Path=Value, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Height="25" Width="25" FontSize="16"/>
        </DockPanel>
        <Button Content="Save and exit"
        Click="SaveExitClick" Height="40" Width="150"/>
    </StackPanel>
</Page>
